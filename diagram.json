{
  "version": 1,
  "author": "corexy-test",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0 },

    { "type": "wokwi-a4988", "id": "driverA", "top": 120, "left": 120 },
    { "type": "wokwi-stepper-motor", "id": "motorA", "top": 120, "left": 320 },

    { "type": "wokwi-a4988", "id": "driverB", "top": 280, "left": 120 },
    { "type": "wokwi-stepper-motor", "id": "motorB", "top": 280, "left": 320 },

    { "type": "wokwi-led", "id": "magnet_led", "top": -120, "left": 260, "attrs": { "color": "blue" }},
    { "type": "wokwi-resistor", "id": "magnet_res", "top": -80, "left": 260, "attrs": { "value": "220" }}
  ],

  "connections": [

    ["esp:3V3","driverA:VDD","red"],
    ["esp:GND","driverA:GND","black"],

    ["esp:3V3","driverB:VDD","red"],
