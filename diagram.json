    ["esp:26","driverA:STEP","green"],
    ["esp:27","driverA:DIR","blue"],

    ["esp:14","driverB:STEP","green"],
    ["esp:12","driverB:DIR","blue"],

    ["driverA:RESET","driverA:SLEEP","yellow"],
