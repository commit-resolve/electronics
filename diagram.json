    ["driverB:RESET","driverB:SLEEP","yellow"],
    ["driverB:RESET","driverB:VDD","yellow"],

    ["driverA:MS1","driverA:GND","black"],
    ["driverA:MS2","driverA:GND","black"],
    ["driverA:MS3","driverA:GND","black"],

    ["driverB:MS1","driverB:GND","black"],
    ["driverB:MS2","driverB:GND","black"],
    ["driverB:MS3","driverB:GND","black"],

    ["driverA:1A","motorA:A+","orange"],
    ["driverA:1B","motorA:A-","orange"],
    ["driverA:2A","motorA:B+","purple"],
    ["driverA:2B","motorA:B-","purple"],

    ["driverB:1A","motorB:A+","orange"],
    ["driverB:1B","motorB:A-","orange"],
    ["driverB:2A","motorB:B+","purple"],
    ["driverB:2B","motorB:B-","purple"],

    ["esp:25","magnet_res:1","green"],
    ["magnet_res:2","magnet_led:A","green"],
    ["magnet_led:C","esp:GND","black"]
